# Optional: enable LLM-based SQL generation. Rule-based generation works without this.
LLM_ENABLED=false
OPENAI_API_KEY=
LLM_MODEL=gpt-4.1-mini

# Retrieval
USE_BGE=true
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5

# Optional external adapters (not required for local demo)
QDRANT_URL=
ELASTICSEARCH_URL=

# Safety / runtime
MAX_REPAIR_ATTEMPTS=2
MAX_RESULT_ROWS=200
