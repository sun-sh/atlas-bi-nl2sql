# Optional: enable LLM-based SQL generation. Rule-based generation works without this.
LLM_ENABLED=false
LLM_PROVIDER=openai
LLM_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
LLM_MODEL=gpt-4.1-mini

# Optional retrieval (install with: pip install -r requirements-retrieval.txt)
USE_BGE=false
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
# 0 = deterministic business-table routing only (default)
# 1 = allow at most one top-1 retrieval table to enter the SQL prompt
ATLAS_RETRIEVAL_SUPPLEMENTS=0

# Optional external adapters
QDRANT_URL=
ELASTICSEARCH_URL=

# Safety / runtime
MAX_REPAIR_ATTEMPTS=2
MAX_RESULT_ROWS=200
QUERY_TIMEOUT_SECONDS=5

# Model call governance
MODEL_CALL_TIMEOUT_SECONDS=30
MODEL_MAX_CONCURRENCY=4
MODEL_ADMISSION_TIMEOUT_SECONDS=5
MODEL_SQL_MAX_TOKENS=1800
MODEL_SQL_RETRY_MAX_TOKENS=3600

# Short-term analysis session storage
ATLAS_SESSION_DB_PATH=data/sessions.db

# Evaluation and data-platform stores
ATLAS_EVALUATION_DB_PATH=data/evaluation_tasks.db
ATLAS_DATA_PLATFORM_DB_PATH=data/data_platform.db
ATLAS_PLATFORM_WAREHOUSE_DB_PATH=data/platform_warehouse.db

# Runtime overrides
ATLAS_MODEL_CONFIG_PATH=data/model_config.json
ATLAS_DISABLE_MODEL=0

# Optional operator gate for write/admin routes.
# Leave empty for the local demo; set a long random value in shared deployments.
ATLAS_ADMIN_API_TOKEN=

# Active data-platform workspace used by the query path.
ATLAS_WORKSPACE_ID=default
