1' AND '2026-02-28'\n) AS order_summary\nCROSS JOIN (\n  SELECT\n    COUNT(rf.refund_id) AS 退款单数,\n    SUM(rf.refund_amount) AS 退款金额\n  FROM refunds AS rf\n  JOIN orders AS o2 ON rf.order_id = o2.order_id\n  WHERE o2.order_date BETWEEN '2025-10-01' AND '2026-02-28'\n) AS refund_summary;",       "error": "未授权函数：case",       "elapsed_ms": 1.81     }   ],   "hit": false,   "elapsed_ms": 59494.9,   "error": "范围守卫结果不符：期望 clarification，实际 answered" }
